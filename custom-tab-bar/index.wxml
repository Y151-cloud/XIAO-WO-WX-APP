<view class="tabbar">
  <view wx:for="{{list}}" wx:key="url" class="tab-item {{active === index ? 'selected' : ''}}"
    data-index="{{index}}" bindtap="onChange">
    <view class="icon-wrap"><van-icon name="{{active === index ? item.selected : item.icon}}"
        size="23" /></view><text>{{item.name}}</text>
    <view wx:if="{{active === index}}" class="active-dot"></view>
  </view>
</view>
