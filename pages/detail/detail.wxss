.detail-screen {
  padding-bottom: 200rpx
}

.detail-card {
  padding: 30rpx
}

.detail-author {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 27rpx;
  font-weight: 600
}

.detail-meta {
  font-size: 20rpx;
  color: #a3ad97;
  font-weight: 400;
  margin-top: 6rpx
}

.detail-title {
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.6;
  margin: 28rpx 0 20rpx;
  color: #425037
}

.detail-content {
  font-size: 29rpx;
  line-height: 1.95;
  white-space: pre-wrap;
  color: #737e68;
  margin-bottom: 26rpx
}

.detail-image {
  width: 100%;
  border-radius: 18rpx;
  margin-top: 14rpx;
  background: #edf0e4
}

.detail-footer {
  color: #aab49d;
  font-size: 21rpx;
  padding-top: 30rpx
}

.detail-actions {
  gap: 26rpx
}

.detail-actions>view {
  gap: 9rpx
}

.detail-price {
  color: #d58155;
  font-size: 48rpx;
  font-weight: 650;
  margin-bottom: 22rpx
}

.detail-price text {
  font-size: 22rpx;
  color: #b6baa9;
  text-decoration: line-through;
  margin-left: 20rpx;
  font-weight: 400
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx;
  margin-top: 22rpx;
  gap: 15rpx
}

.action-card-title {
  font-size: 25rpx;
  color: #7a8a69
}

.action-card .form-note {
  font-size: 20rpx;
  margin: 8rpx 0 0
}

.join-button {
  width: auto;
  height: 70rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  flex-shrink: 0
}

.comment-count {
  font-size: 24rpx;
  color: #a5b192;
  margin-left: 8rpx
}

.comment-card {
  padding: 10rpx 28rpx
}

.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2e8
}

.comment-item:last-child {
  border: 0
}

.comment-avatar {
  width: 54rpx;
  height: 54rpx;
  background: #edf0e4;
  border-radius: 18rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 54rpx;
  color: #a3b08e;
  flex-shrink: 0
}

.comment-copy {
  flex: 1;
  min-width: 0
}

.comment-name {
  color: #7a8968;
  font-size: 24rpx
}

.comment-time {
  font-size: 18rpx;
  color: #b0baa1
}

.comment-content {
  font-size: 26rpx;
  color: #7f8973;
  line-height: 1.8;
  margin-top: 10rpx;
  white-space: pre-wrap
}

.comment-empty {
  text-align: center;
  padding: 35rpx 0
}

.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0e5
}

.comment-bar input {
  flex: 1;
  min-width: 0;
  background: #f4f6ed;
  border-radius: 15rpx;
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 23rpx
}

.comment-send {
  background: #dd8154;
  color: #fff;
  border-radius: 14rpx;
  padding: 17rpx 22rpx;
  font-size: 25rpx
}

.comment-send[disabled] {
  opacity: .45
}

.delete-link {
  font-size: 22rpx;
  color: #b89b89;
  margin-top: 25rpx;
  text-align: right
}
