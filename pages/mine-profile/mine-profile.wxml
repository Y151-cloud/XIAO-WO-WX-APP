<view class="screen">
  <view class="eyebrow">A LITTLE MORE ABOUT YOU</view>
  <view class="page-title settings-title">这是你的小窝名片。</view>
  <view class="profile-edit-avatar" bindtap="onChangeAvatar">
    <image src="{{userInfo.avatarUrl || '/static/art/avatar.png'}}" mode="aspectFill" />
    <view class="avatar-edit"><van-icon name="photograph" size="18" /></view>
  </view>
  <view class="avatar-hint">点击头像，换个新模样</view>
  <view class="paper">
    <view class="menu-row" bindtap="onEditNickname"><text class="menu-copy">昵称</text><text
        class="profile-value">{{userInfo.nickName || '小窝同学'}}</text><van-icon name="arrow" size="12"
        color="#b0bba0" /></view>
    <view class="menu-row" bindtap="onShowGender"><text class="menu-copy">性别</text><text
        class="profile-value">{{genderText}}</text><van-icon name="arrow" size="12"
        color="#b0bba0" /></view>
    <view class="menu-row" bindtap="onEditSchool"><text class="menu-copy">学校</text><text
        class="profile-value">{{userInfo.school || '待填写'}}</text><van-icon name="arrow" size="12"
        color="#b0bba0" /></view>
    <view class="menu-row" bindtap="onEditStudentId"><text class="menu-copy">学号</text><text
        class="profile-value">{{userInfo.studentId || '待填写'}}</text><van-icon name="arrow" size="12"
        color="#b0bba0" /></view>
    <view class="menu-row" bindtap="onEditSignature"><text class="menu-copy">签名</text><text
        class="profile-value">{{userInfo.signature || '记录一点自己的样子'}}</text><van-icon name="arrow"
        size="12" color="#b0bba0" /></view>
  </view>
  <view class="form-note profile-note">资料修改后会自动保存到本机。</view>
  <van-action-sheet show="{{showGenderSheet}}" actions="{{genderActions}}"
    bind:close="onCloseGender" bind:select="onSelectGender" cancel-text="取消"
    bind:cancel="onCloseGender" round />
</view>
