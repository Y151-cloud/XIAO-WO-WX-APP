.settings-title {
  font-size: 38rpx;
  margin-top: 20rpx
}

.profile-edit-avatar {
  width: 150rpx;
  height: 150rpx;
  margin: 40rpx auto 20rpx;
  position: relative
}

.profile-edit-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50rpx;
  border: 8rpx solid white;
  background: #e9efdd
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: -5rpx;
  border: 4rpx solid #f7f8f2;
  border-radius: 50%;
  background: #a8b78d;
  color: white;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center
}

.avatar-hint {
  text-align: center;
  color: #a8b695;
  font-size: 22rpx;
  margin-bottom: 40rpx
}

.profile-value {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #a9b69a;
  font-size: 24rpx
}

.profile-note {
  text-align: center
}
