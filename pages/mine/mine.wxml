<view class="screen tab-screen">
  <view class="row between"><text class="eyebrow">WELCOME TO YOUR LITTLE NEST</text>
    <view class="setting" bindtap="setting"><van-icon name="setting-o" size="22" /></view>
  </view>
  <view class="profile-row" bindtap="profile">
    <image class="profile-avatar" src="{{userInfo.avatarUrl || '/static/art/avatar.png'}}"
      mode="aspectFill" />
    <view class="profile-copy">
      <view class="profile-name">{{userInfo.nickName || '小窝同学'}}</view>
      <view class="profile-school"><van-icon name="location-o" size="12" />
        {{userInfo.school || '我的大学'}}</view>
      <view class="profile-signature">{{userInfo.signature || '在校园里，发现每一个小美好'}}</view>
    </view><van-icon name="arrow" size="15" color="#a8b495" />
  </view>
  <view class="stats-card">
    <view class="stat-publish" bindtap="publications"><text class="stat-number">{{stats.publish}}</text><text
        class="stat-label">我的发布</text></view>
    <view class="stat-favorite" bindtap="favorites"><text class="stat-number">{{stats.favorite}}</text><text
        class="stat-label">我的收藏</text></view>
    <view class="stat-joined" bindtap="joined"><text class="stat-number">{{stats.joined}}</text><text
        class="stat-label">参与活动</text></view>
    <view bindtap="orders"><text class="stat-number">{{stats.orders}}</text><text
        class="stat-label">服务订单</text></view>
  </view>
  <view class="nest-card">
    <view>
      <view class="nest-title">小窝虽小，装得下整个校园。</view>
      <view class="nest-note">谢谢你，让这里多了一份温暖。</view>
    </view><text class="nest-flower">✳</text>
  </view>
  <view class="section-head"><text class="section-title">我的校园生活</text></view>
  <view class="paper">
    <view class="menu-row" bindtap="publications">
      <view class="menu-icon"><van-icon name="notes-o" size="23" /></view><text
        class="menu-copy">我的发布</text><van-icon name="arrow" size="13" color="#acb79e" />
    </view>
    <view class="menu-row" bindtap="favorites">
      <view class="menu-icon"><van-icon name="star-o" size="23" /></view><text
        class="menu-copy">我的收藏</text><van-icon name="arrow" size="13" color="#acb79e" />
    </view>
    <view class="menu-row" bindtap="history">
      <view class="menu-icon"><van-icon name="clock-o" size="23" /></view><text
        class="menu-copy">浏览记录</text><van-icon name="arrow" size="13" color="#acb79e" />
    </view>
    <view class="menu-row" bindtap="messages">
      <view class="menu-icon"><van-icon name="chat-o" size="23" /></view><text
        class="menu-copy">我的消息</text><text class="menu-description">校园通知</text><van-icon
        name="arrow" size="13" color="#acb79e" />
    </view>
  </view>
  <view class="section-head"><text class="section-title">小窝陪着你</text></view>
  <view class="paper">
    <view class="menu-row" bindtap="guide"><van-icon name="question-o" size="21"
        color="#a0ae89" /><text class="menu-copy">帮助中心</text><van-icon name="arrow" size="13"
        color="#acb79e" /></view>
    <view class="menu-row" bindtap="feedback"><van-icon name="comment-o" size="21"
        color="#a0ae89" /><text class="menu-copy">意见反馈</text><van-icon name="arrow" size="13"
        color="#acb79e" /></view>
    <view class="menu-row" bindtap="about"><van-icon name="info-o" size="21" color="#a0ae89" /><text
        class="menu-copy">关于校窝</text><text class="menu-description">v1.1.0</text><van-icon
        name="arrow" size="13" color="#acb79e" /></view>
  </view>
  <view class="mine-footer">XIAOWO · 让校园的每一天，都有小美好</view>
</view>
