.setting {
  color: #8c9b78;
  padding: 10rpx
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 36rpx 0
}

.profile-avatar {
  width: 126rpx;
  height: 126rpx;
  border-radius: 42rpx;
  border: 7rpx solid white;
  background: #e6ecd9
}

.profile-copy {
  flex: 1;
  min-width: 0
}

.profile-name {
  font-size: 38rpx;
  font-weight: 650;
  color: #4a593d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis
}

.profile-school {
  font-size: 21rpx;
  color: #98a882;
  margin-top: 8rpx
}

.profile-signature {
  font-size: 21rpx;
  color: #acb49e;
  margin-top: 7rpx
}

.stats-card {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border: 1rpx solid #eaf0df;
  border-radius: 24rpx;
  padding: 30rpx 10rpx
}

.stats-card>view {
  display: flex;
  align-items: center;
  flex-direction: column;
  flex: 1;
  border-right: 1rpx solid #edf0e5
}

.stats-card>view:last-child {
  border: 0
}

.stat-number {
  font-size: 40rpx;
  color: #60734f;
  font-weight: 650
}

.stat-label {
  font-size: 21rpx;
  color: #a4ae98;
  margin-top: 8rpx
}

.nest-card {
  background: #eaf0df;
  border-radius: 20rpx;
  margin-top: 22rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between
}

.nest-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #83976a
}

.nest-note {
  font-size: 20rpx;
  color: #a4b18f;
  margin-top: 7rpx
}

.nest-flower {
  font-size: 67rpx;
  line-height: 1;
  color: #afbf93
}

.mine-footer {
  text-align: center;
  font-size: 18rpx;
  color: #b1bca3;
  margin: 40rpx 0 15rpx;
  letter-spacing: 2rpx
}
