<view class="container">
  <view class="publish-bar">
    <van-button type="primary" round color="#FF6B35" icon="plus" bindtap="toggleForm">
      {{showForm ? '收起' : '发布跑腿需求'}}
    </van-button>
  </view>

  <view class="form-card" wx:if="{{showForm}}">
    <van-cell-group>
      <van-field label="标题" placeholder="简要描述你的需求" value="{{form.title}}" data-field="title" bind:input="onFormInput" />
      <van-field label="详细描述" type="textarea" placeholder="详细说明你需要什么帮助" value="{{form.content}}" data-field="content" bind:input="onFormInput" autosize />
      <van-field label="酬劳" placeholder="如：5元、一杯奶茶" value="{{form.reward}}" data-field="reward" bind:input="onFormInput" />
      <van-field label="联系方式" placeholder="微信号/手机号" value="{{form.contact}}" data-field="contact" bind:input="onFormInput" />
      <van-field label="截止时间" placeholder="如：今天下午3点" value="{{form.deadline}}" data-field="deadline" bind:input="onFormInput" />
    </van-cell-group>
    <view class="form-btn">
      <van-button type="primary" round block color="#FF6B35" loading="{{submitting}}" bindtap="onSubmit">发布</van-button>
    </view>
  </view>

  <!-- 列表 -->
  <scroll-view scroll-y style="height: calc(100vh - 120rpx);" bindscrolltolower="onLoadMore" refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}">
    <view class="list-wrap">
      <block wx:if="{{list.length > 0}}">
        <view class="errand-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
          <view class="errand-header">
            <image class="avatar" src="{{item.userAvatar || '/static/images/default-avatar.png'}}" />
            <view class="errand-meta">
              <text class="nickname">{{item.userNickname || '匿名用户'}}</text>
              <text class="time">{{item.createTime}}</text>
            </view>
            <van-tag type="warning" size="medium" wx:if="{{item.reward}}">¥ {{item.reward}}</van-tag>
          </view>
          <view class="errand-body">
            <text class="errand-title">{{item.title}}</text>
            <text class="errand-content">{{item.content}}</text>
          </view>
          <view class="errand-footer">
            <view class="errand-info">
              <van-icon name="clock-o" size="28rpx" color="#999" />
              <text>截止：{{item.deadline || '不限'}}</text>
            </view>
            <view class="errand-info" wx:if="{{item.contact}}">
              <van-icon name="phone-o" size="28rpx" color="#FF6B35" />
              <text class="contact-text">联系TA</text>
            </view>
          </view>
        </view>
        <view class="loading-more" wx:if="{{loading}}">
          <van-loading size="24">加载中...</van-loading>
        </view>
        <view class="no-more" wx:if="{{finished && list.length > 0}}">
          <text>没有更多了</text>
        </view>
      </block>
      <van-empty wx:if="{{!loading && list.length === 0}}" description="暂无跑腿需求" />
    </view>
  </scroll-view>
</view>