<view class="container">
  <view class="publish-bar">
    <van-button type="primary" round color="#07C160" icon="plus" bindtap="toggleForm">
      {{showForm ? '收起' : '创建投票'}}
    </van-button>
  </view>

  <!-- 创建投票表单 -->
  <view class="form-card" wx:if="{{showForm}}">
    <van-cell-group>
      <van-field label="投票标题" placeholder="你想投什么？" value="{{form.title}}" data-field="title" bind:input="onFormInput" />
      <van-field label="补充说明" type="textarea" placeholder="可选，补充说明" value="{{form.content}}" data-field="content" bind:input="onFormInput" autosize />
    </van-cell-group>

    <view class="options-section">
      <text class="options-label">投票选项</text>
      <view class="option-item" wx:for="{{form.options}}" wx:key="index">
        <van-field placeholder="选项 {{index + 1}}" value="{{item}}" data-index="{{index}}" bind:input="onOptionInput" />
        <van-icon name="cross" size="36rpx" color="#999" data-index="{{index}}" bindtap="removeOption" wx:if="{{form.options.length > 2}}" />
      </view>
      <view class="add-option" bindtap="addOption">
        <van-icon name="plus" size="32rpx" color="#07C160" />
        <text>添加选项</text>
      </view>
    </view>

    <view class="form-btn">
      <van-button type="primary" round block color="#07C160" loading="{{submitting}}" bindtap="onSubmit">发起投票</van-button>
    </view>
  </view>

  <!-- 列表 -->
  <scroll-view scroll-y style="height: calc(100vh - 120rpx);" bindscrolltolower="onLoadMore" refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}">
    <view class="list-wrap">
      <block wx:if="{{list.length > 0}}">
        <view class="vote-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
          <view class="vote-header">
            <image class="avatar" src="{{item.userAvatar || '/static/images/default-avatar.png'}}" />
            <view class="vote-meta">
              <text class="nickname">{{item.userNickname || '匿名用户'}}</text>
              <text class="time">{{item.createTime}}</text>
            </view>
            <van-tag type="success" size="medium">投票</van-tag>
          </view>
          <text class="vote-title">{{item.title}}</text>
          <text class="vote-desc" wx:if="{{item.content}}">{{item.content}}</text>
          <view class="vote-options" wx:if="{{item.options}}">
            <view class="vote-option" wx:for="{{item.options}}" wx:for-item="opt" wx:key="*this">
              <view class="option-bar">
                <text class="option-text">{{opt}}</text>
              </view>
            </view>
          </view>
          <view class="vote-footer">
            <text class="vote-count">{{item.voteCount || 0}} 人参与</text>
            <text class="vote-time">{{item.createTime}}</text>
          </view>
        </view>
        <view class="loading-more" wx:if="{{loading}}">
          <van-loading size="24">加载中...</van-loading>
        </view>
        <view class="no-more" wx:if="{{finished && list.length > 0}}">
          <text>没有更多了</text>
        </view>
      </block>
      <van-empty wx:if="{{!loading && list.length === 0}}" description="暂无投票" />
    </view>
  </scroll-view>
</view>