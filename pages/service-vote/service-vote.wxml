<view class="screen">
  <view class="eyebrow">EVERY VOICE COUNTS</view>
  <view class="page-title vote-heading">让你的想法，被听见。</view>
  <view class="page-subtitle">校园怎么更好玩，一起说了算</view>
  <view wx:if="{{error}}" class="error-box" bindtap="load">{{error}} · 点击重试</view>
  <view wx:for="{{votes}}" wx:for-item="vote" wx:key="id" class="paper vote-card">
    <view class="row between"><text class="pill">{{vote.label}}</text><text
        class="vote-total">{{vote.total}} 位同学参与</text></view>
    <view class="vote-title">{{vote.title}}</view>
    <view class="vote-description">{{vote.description}}</view>
    <view wx:for="{{vote.options}}" wx:for-item="option" wx:key="id" data-id="{{vote.id}}"
      data-option="{{option.id}}" bindtap="vote"
      class="vote-option {{vote.selected === option.id ? 'voted' : ''}}">
      <view wx:if="{{vote.selected}}" class="vote-progress" style="width:{{option.percent}}%">
      </view>
      <view class="row between option-copy"><text>{{option.text}}</text><text
          wx:if="{{vote.selected}}">{{option.percent}}% {{vote.selected === option.id ? '✓' : ''}}</text><van-icon wx:else name="circle" size="18"
          color="#b9c3a9" /></view>
    </view>
    <view class="vote-note">{{vote.selected ? '你已参与，为校园生活投下一票 ✓' : '选择一个选项即可投票 · 每人限投一次'}}</view>
  </view>
  <view class="status">{{loading ? '正在加载校园议题…' : '小小的选择，也能改变身边的日常'}}</view>
</view>
