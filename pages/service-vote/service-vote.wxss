.container {
  background-color: #F5F5F5;
  min-height: 100vh;
}

.publish-bar {
  padding: 24rpx;
  display: flex;
  justify-content: center;
}

.form-card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.options-section {
  padding: 24rpx;
}
.options-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}
.option-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.option-item van-field {
  flex: 1;
}
.add-option {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  color: #07C160;
  font-size: 28rpx;
}
.add-option text {
  margin-left: 8rpx;
}
.form-btn {
  padding: 0 24rpx 24rpx;
}

.list-wrap {
  padding: 0 24rpx 20rpx;
}

.vote-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.vote-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.vote-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.vote-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.vote-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}
.vote-options {
  margin: 16rpx 0;
}
.vote-option {
  margin-bottom: 12rpx;
}
.option-bar {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.option-text {
  font-size: 26rpx;
  color: #333;
}
.vote-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.vote-count {
  font-size: 24rpx;
  color: #07C160;
}
.vote-time {
  font-size: 22rpx;
  color: #999;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}
.no-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #999;
}