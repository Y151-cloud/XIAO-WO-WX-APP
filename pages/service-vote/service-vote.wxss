.vote-heading {
  font-size: 39rpx;
  margin-top: 20rpx
}

.vote-card {
  padding: 30rpx;
  margin-top: 28rpx
}

.vote-total {
  font-size: 20rpx;
  color: #a4b290
}

.vote-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.7;
  margin-top: 24rpx
}

.vote-description {
  font-size: 25rpx;
  line-height: 1.8;
  color: #a0ac91;
  margin: 16rpx 0 25rpx
}

.vote-option {
  position: relative;
  background: #f5f7ee;
  border: 1rpx solid #e9efde;
  border-radius: 14rpx;
  overflow: hidden;
  margin-top: 16rpx
}

.vote-progress {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background: #e4ecd7
}

.option-copy {
  position: relative;
  z-index: 1;
  padding: 22rpx;
  font-size: 25rpx;
  color: #879972;
  gap: 12rpx
}

.voted {
  border-color: #afbe98
}

.voted .vote-progress {
  background: #d9e6c6
}

.vote-note {
  font-size: 20rpx;
  color: #b2bca3;
  margin-top: 22rpx
}
